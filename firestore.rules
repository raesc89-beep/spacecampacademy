rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // FUNCIONES AUXILIARES
    // ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ─────────────────────────────────────────────
    // COLECCIÓN: users
    // Cada usuario solo puede leer y escribir su propio documento.
    // Los admins pueden leer todos los documentos (panel de usuarios).
    // Solo admins pueden actualizar el campo "role".
    // ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
                       !('role' in request.resource.data) ||
                       isAdmin();
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // COLECCIÓN: system
    // Solo lectura para usuarios autenticados (para ver si hay transmisión).
    // Solo admins pueden escribir (configurar transmisiones).
    // ─────────────────────────────────────────────
    match /system/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // COLECCIÓN: modules
    // Cualquier usuario autenticado puede leer el progreso.
    // Cada usuario puede escribir solo su propio progreso.
    // ─────────────────────────────────────────────
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ─────────────────────────────────────────────
    // COLECCIÓN: evaluations
    // Cualquier usuario autenticado puede crear una evaluación.
    // Solo admins pueden leer todas.
    // ─────────────────────────────────────────────
    match /evaluations/{evalId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────
    // BLOQUEO GLOBAL: cualquier colección no listada
    // está completamente bloqueada por defecto.
    // ─────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
